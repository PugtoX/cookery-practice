# Build output — generated by `npm run build`, never edited by hand.
dist

# Dependencies. This project has none of its own, but the checks need puppeteer-core
# installed with --no-save, which creates node_modules anyway.
node_modules

# Lighthouse reports are large; regenerate with:
#   npx lighthouse <url> --output=json --output-path=docs/lighthouse/mobile.report.json
# docs/lighthouse/summary.md is the human-readable record and IS committed.
docs/lighthouse/*.json
docs/lighthouse/*.html

# Editor and OS noise
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
